# Copy to .env (never commit .env). The pipeline also reads the repository-root .env.
# Contact string sent in the User-Agent so agencies can reach the project team.
# Use a team/shared address, not a personal one.
DL3_CONTACT=dl3-sprint-team@example.org
# LLM extraction: provider set in config/settings.yaml (llm.provider), or override here.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
